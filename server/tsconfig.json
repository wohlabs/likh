{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node20",
    "rootDir": "src",   // your TS source folder
    "outDir": "dist",      // where JS files go
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
	"types": ["node"],
	"moduleResolution": "nodenext"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}